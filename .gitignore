/.env
/files/*
!/files/.gitkeep
# Логи НЕ версионируем — ни одного файла. Прежде здесь стояли только инстансные имена
# (option_*.log), а logs/error.log попал в индекс когда-то раньше и с тех пор ехал в историю
# коммитов: боевые ошибки в репозитории, а любой локальный прогон делал дерево грязным.
# Снят с отслеживания (git rm --cached), файл остался на диске.
/logs/*.log
/logs/option_*/
# Рабочие скрины всех инстансов (shot_*/screenshot_*) + превью — не версионируем
/pictures/shot_*.png
/pictures/screenshot_*.png

/.venv/
/.idea/
__pycache__/
*.pyc
/pictures/new/

# Локальные диагностические/одноразовые скрипты — не версионируем
scripts/
/telegram_id_changes.csv

# Диагностические артефакты (стянутые логи сервера, дампы сплеша, скрины-вещдоки) — не версионируем
/ServerLogs/
/debug_dumps/
/binodex_stuck_splash.png
/devlog_splash_*
